<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="vlad_tsurko">
        <createTable tableName="stations">
            <column name="code" type="VARCHAR(3)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)"/>
        </createTable>

        <createTable tableName="trips">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="train_number" type="VARCHAR(5)"/>
            <column name="from_station_code" type="VARCHAR(3)"/>
            <column name="to_station_code" type="VARCHAR(3)"/>
            <column name="departure_time" type="timestamp"/>
            <column name="arrival_time" type="timestamp"/>
        </createTable>

        <createTable tableName="trip_rates">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="trip_id" type="INT">
                <constraints
                        nullable="false"
                        foreignKeyName="fk_trips_id"
                        referencedTableName="trips"
                        referencedColumnNames="id"/>
            </column>
            <column name="rate_code" type="VARCHAR(20)">
                <constraints nullable="false"
                             checkConstraint="rate_code IN ('PROMO', 'STANDARD')"/>
            </column>
            <column name="price" type="decimal(7,2)">
                <constraints nullable="false" checkConstraint="price >= 0"/>
            </column>
            <column name="available_seats" type="int">
                <constraints nullable="false" checkConstraint="available_seats >= 0"/>
            </column>
        </createTable>

        <createTable tableName="reservations">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="trip_id" type="INT">
                <constraints
                        nullable="false"
                        foreignKeyName="fk_trips_id"
                        referencedTableName="trips"
                        referencedColumnNames="id"/>
            </column>
            <column name="rate_code" type="VARCHAR(20)">
                <constraints nullable="false"
                             checkConstraint="rate_code IN ('PROMO', 'STANDARD')"/>
            </column>
            <column name="passenger_count" type="int">
                <constraints nullable="false" checkConstraint="passenger_count > 0"/>
            </column>
            <column name="total_price" type="decimal(7,2)">
                <constraints nullable="false" checkConstraint="total_price > 0"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"
                             checkConstraint="status IN ('HELD', 'CONFIRMED', 'CANCELLED', 'EXPIRED')"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP"/>
        </createTable>

    </changeSet>

